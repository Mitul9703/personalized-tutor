# Copy this file to .env and fill in the values. Never commit .env.

# Database
DATABASE_URL=postgresql+psycopg://tutor:tutor@localhost:5432/tutor

# Chat model. OpenAI for now. Later we switch to the ASU CreateAI key,
# which is an AWS Bedrock key, by changing these values.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-key-here
LLM_MODEL=gpt-6-luna

# Local embedding model. Runs on the machine, so it needs no API key.
EMBED_MODEL=BAAI/bge-small-en-v1.5
